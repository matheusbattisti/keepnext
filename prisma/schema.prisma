generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Thought {
  id        String   @id @default(cuid())
  title     String?
  content   String
  color     String   @default("gray")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      Tag[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  thoughts Thought[]
}
